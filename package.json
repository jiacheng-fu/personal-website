{
  "name": "personal-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.cjs",
    "dev:vite": "vite",
    "stop": "node dev.cjs stop",
    "restart": "node dev.cjs restart",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "rag:eval": "esbuild scripts/rag-eval.ts --bundle --format=esm --platform=node --loader:.json=json --outfile=node_modules/.cache/rag-eval.mjs --log-level=error && node node_modules/.cache/rag-eval.mjs",
    "rag:gates": "esbuild scripts/engine-gates.ts --bundle --format=esm --platform=node --external:@mlc-ai/web-llm --external:@huggingface/transformers --outfile=node_modules/.cache/engine-gates.mjs --log-level=error && node node_modules/.cache/engine-gates.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.27.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
